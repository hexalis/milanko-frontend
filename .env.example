# Añade aquí solamente nombres de variables de entorno sin valores secretos.

# Base de la API de Milanko que usa el servidor de Next (incluye la versión).
#   develop:    https://dev-milanko.hexalis.org/api/v1
#   qa:         https://qa-milanko.hexalis.org/api/v1
#   production: https://milanko.hexalis.org/api/v1
# En el VPS puede apuntar al backend interno del mismo ambiente (sin pasar por nginx).
MILANKO_API_URL=https://dev-milanko.hexalis.org/api/v1

# Nombre del ambiente que se muestra en la interfaz: local | develop | qa | production
APP_ENV=local
