{
  "name": "milanko-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Milanko: Earth Trend Detective frontend (Next.js)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm knip",
    "prepare": "lefthook install",
    "api:types": "pnpm dlx --package openapi-typescript@7.13.0 --package typescript@5.9.3 openapi-typescript https://dev-milanko.hexalis.org/api/v1/openapi.json -o src/server/integrations/milanko-api/schema.d.ts"
  },
  "dependencies": {
    "@hexalis/components": "0.2.0",
    "@hexalis/design-system": "0.2.0",
    "d3-array": "^3.2.5",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "next": "16.4.2",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^30.1.3",
    "knip": "^6.45.1",
    "lefthook": "2.2.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^7",
    "vitest": "^5.1.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "packageManager": "pnpm@12.14.0"
}
